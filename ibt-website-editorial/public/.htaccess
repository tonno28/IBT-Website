# Nur für Apache-Hosting (IONOS). Next legt das OG-Bild ohne Dateiendung ab,
# Apache würde es sonst als Text ausliefern und Link-Vorschauen blieben leer.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Eigene Fehlerseite statt der Apache-Standardseite. Next legt sie beim
# statischen Export als 404.html ins Wurzelverzeichnis.
ErrorDocument 404 /404.html

# Die Seite "Über mich" gibt es seit 26.09.2026 nicht mehr.
RedirectMatch 301 ^/ueber-mich/?$ /
